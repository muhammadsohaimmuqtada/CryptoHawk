# CryptoHawk 0.9 production/pilot template.
# Copy to a deployment secret store or host environment and replace every required blank.
# The application intentionally refuses to start in production when these invariants are unsafe.

CRYPTOHAWK_ENVIRONMENT=production

# Required PostgreSQL configuration. Percent-encode reserved password characters in the URL.
CRYPTOHAWK_POSTGRES_PASSWORD=
CRYPTOHAWK_DATABASE_URL=

# Empty is valid for same-origin deployments. Otherwise use comma-separated explicit HTTPS origins.
CRYPTOHAWK_CORS_ORIGINS=
CRYPTOHAWK_ALLOW_PRIVATE_TARGETS=false
CRYPTOHAWK_ALLOW_LEGACY_GLOBAL_API=false
CRYPTOHAWK_AUTO_CREATE_SCHEMA=false

# Required versioned AES-256-GCM connector keyring.
# Format: VERSION:<base64url-encoded 32-byte key>[,VERSION:<key>...]
# The same versioned keyring encrypts short-lived OIDC transaction verifier/nonce state when SSO is enabled.
CRYPTOHAWK_CONNECTOR_ENCRYPTION_KEYS=
CRYPTOHAWK_CONNECTOR_ENCRYPTION_ACTIVE_VERSION=1

# Authentication, quotas and concurrency.
CRYPTOHAWK_SESSION_HOURS=12
CRYPTOHAWK_PRINCIPAL_REQUESTS_PER_MINUTE=600
CRYPTOHAWK_WORKSPACE_REQUESTS_PER_MINUTE=300
CRYPTOHAWK_LOGIN_ATTEMPTS_PER_15_MINUTES=10
CRYPTOHAWK_BOOTSTRAP_ATTEMPTS_PER_HOUR=5
CRYPTOHAWK_SCAN_SUBMISSIONS_PER_MINUTE=30
CRYPTOHAWK_WORKSPACE_SCAN_CONCURRENCY=4

# Optional enterprise OpenID Connect SSO. Disabled until an IdP application is configured.
# The redirect URI registered at the IdP must exactly match CRYPTOHAWK_OIDC_REDIRECT_URI.
# OIDC users must already exist in CryptoHawk; SSO never grants workspace membership or roles by itself.
CRYPTOHAWK_OIDC_ENABLED=false
CRYPTOHAWK_OIDC_ISSUER=
CRYPTOHAWK_OIDC_CLIENT_ID=
CRYPTOHAWK_OIDC_CLIENT_SECRET=
CRYPTOHAWK_OIDC_REDIRECT_URI=https://cryptohawk.example.com/api/v1/auth/oidc/callback
CRYPTOHAWK_OIDC_FRONTEND_URL=https://cryptohawk.example.com
CRYPTOHAWK_OIDC_SCOPES=openid profile email
CRYPTOHAWK_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
CRYPTOHAWK_OIDC_REQUIRE_VERIFIED_EMAIL=true
CRYPTOHAWK_OIDC_TRANSACTION_TTL_SECONDS=600
CRYPTOHAWK_OIDC_COMPLETION_TTL_SECONDS=120
CRYPTOHAWK_OIDC_HTTP_TIMEOUT_SECONDS=10
# Keep false for public SaaS IdPs. Set true only when the deployment intentionally uses an internal/private IdP.
CRYPTOHAWK_OIDC_ALLOW_PRIVATE_PROVIDER=false

# Telemetry.
CRYPTOHAWK_LOG_LEVEL=INFO
CRYPTOHAWK_METRICS_ENABLED=true
CRYPTOHAWK_METRICS_PATH=/metrics
CRYPTOHAWK_OTEL_SERVICE_NAME=cryptohawk
CRYPTOHAWK_OTEL_TRACES_ENDPOINT=
CRYPTOHAWK_OTEL_EXPORT_TIMEOUT_SECONDS=5

# Repository collector boundaries.
CRYPTOHAWK_REPOSITORY_ALLOWED_HOSTS=github.com,gitlab.com
CRYPTOHAWK_REPOSITORY_FETCH_DEPTH=100
CRYPTOHAWK_REPOSITORY_GIT_TIMEOUT_SECONDS=120
CRYPTOHAWK_REPOSITORY_MAX_FILES=20000
CRYPTOHAWK_REPOSITORY_MAX_SCAN_BYTES=100000000
CRYPTOHAWK_REPOSITORY_MAX_FILE_BYTES=2000000

# Dedicated read-only container archive ingress for self-hosted workers.
CRYPTOHAWK_CONTAINER_ARCHIVE_ROOT=/var/lib/cryptohawk/images
CRYPTOHAWK_CONTAINER_PLATFORM_OS=linux
CRYPTOHAWK_CONTAINER_PLATFORM_ARCH=amd64
CRYPTOHAWK_CONTAINER_MAX_ARCHIVE_BYTES=2000000000
CRYPTOHAWK_CONTAINER_MAX_LAYERS=128
CRYPTOHAWK_CONTAINER_MAX_LAYER_COMPRESSED_BYTES=256000000
CRYPTOHAWK_CONTAINER_MAX_LAYER_UNCOMPRESSED_BYTES=1000000000
CRYPTOHAWK_CONTAINER_MAX_ENTRIES=250000
CRYPTOHAWK_CONTAINER_MAX_FILE_BYTES=2000000
CRYPTOHAWK_CONTAINER_MAX_SCAN_BYTES=150000000
